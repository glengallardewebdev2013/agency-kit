---
// The closing call to action. It sits on ink and joins the footer below it.
// joined: it follows another ink section (the work wheel), so no gap above it.
interface Props { heading: string; text?: string; label?: string; href?: string; joined?: boolean }
const { heading, text, label = 'Start a project', href = '/contact/', joined = false } = Astro.props;
---
<section class:list={['cta field relative isolate overflow-clip', { joined }]}>
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="container-site flex flex-col items-center pt-28 text-center md:pt-36">
    <h2 class="max-w-[18ch] text-[length:var(--text-h2)]">{heading}</h2>
    {text && <p class="mt-5 max-w-xl text-[1.0625rem] text-muted">{text}</p>}
    <a href={href} class="btn btn-primary mt-8">{label}</a>
  </div>
</section>

<style>
  .cta {
    margin-top: var(--section-gap);
  }
  .cta.joined {
    margin-top: 0;
  }
  .cta-glow {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 0;
    width: min(1400px, 120vw);
    height: 100%;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(252 76 2 / 0.16), transparent);
    pointer-events: none;
  }
</style>
