---
interface Props { heading: string; text?: string; label?: string; href?: string }
const { heading, text, label = 'Start a project', href = '/contact/' } = Astro.props;
---
<section class="field mt-16 py-16 md:py-24">
  <div class="container-site grid gap-8 md:grid-cols-12 md:items-end">
    <div class="md:col-span-8">
      <h2 class="text-4xl md:text-6xl">{heading}</h2>
      {text && <p class="mt-4 max-w-2xl text-lg">{text}</p>}
    </div>
    <div class="md:col-span-4 md:justify-self-end">
      <a href={href} class="btn btn-primary">{label}</a>
    </div>
  </div>
</section>
