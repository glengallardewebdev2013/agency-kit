---
// The hero's hand of pages: concept sites fanned like cards, desktops on an
// arc with phones tucked between them. CSS only; it deals itself on arrival.
import { concepts } from '../lib/work';
const desks = concepts;
const phones = [concepts[3], concepts[0], concepts[1]];
---
<div class="fan" aria-label="Concept sites, made to show the style" role="group">
  <div class="fan-hand">
    {desks.map((c, i) => (
      <figure class="fan-card fan-card--desk" style={`--i:${i}`} tabindex="0">
        <img src={`/work/${c.slug}.webp`} srcset={`/work/${c.slug}-600.webp 600w, /work/${c.slug}.webp 1200w`} sizes="(max-width: 560px) 210px, (max-width: 820px) 40vw, 520px" width="1200" height="750" alt={c.alt} fetchpriority={i < 2 ? 'high' : undefined} />
        <figcaption class="fan-name">{c.name} · {c.kind}</figcaption>
      </figure>
    ))}
    {phones.map((c, i) => (
      <figure class="fan-card fan-card--phone" style={`--i:${i}`} aria-hidden="true">
        <img src={`/work/${c.slug}-phone-180.webp`} width="180" height="390" alt="" decoding="async" />
      </figure>
    ))}
  </div>
</div>

<style>
  .fan {
    --dw: clamp(200px, min(20vw + 90px, 46vh), 520px);
    position: relative;
    height: calc(var(--dw) * 0.95);
    margin-top: 2.5rem;
  }
  .fan::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 25;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--color-bg));
    pointer-events: none;
  }
  .fan-hand {
    position: absolute;
    left: 50%;
    top: 0;
  }
  .fan-card {
    position: absolute;
    top: 3rem;
    left: 0;
    margin: 0;
    transform-origin: 50% 100%;
    transform: var(--t);
    transition: transform 720ms var(--ease-spring), box-shadow 320ms var(--ease);
    animation: deal 700ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms);
  }
  .fan-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    border-radius: inherit;
  }
  .fan-card--desk {
    --t: translate(calc((var(--i) - 1.5) * var(--dw) * 0.92), calc((var(--i) - 1.5) * (var(--i) - 1.5) * var(--dw) * 0.08)) rotate(calc((var(--i) - 1.5) * 4.2deg));
    width: var(--dw);
    aspect-ratio: 8 / 5;
    margin-left: calc(var(--dw) / -2);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    z-index: calc(10 - (var(--i) - 1.5) * (var(--i) - 1.5) * 2);
  }
  .fan-card--desk:nth-child(2),
  .fan-card--desk:nth-child(3) {
    z-index: 12;
  }
  .fan-card--phone {
    --t: translate(calc((var(--i) - 1) * var(--dw) * 0.92), calc((var(--i) - 1) * (var(--i) - 1) * var(--dw) * 0.08 + var(--dw) * 0.06)) rotate(calc((var(--i) - 1) * 4.2deg));
    z-index: 15;
    width: calc(var(--dw) * 0.28);
    aspect-ratio: 390 / 844;
    margin-left: calc(var(--dw) * -0.14);
    padding: 3px;
    border-radius: calc(var(--dw) * 0.036);
    background: oklch(24% 0.004 260);
    box-shadow: 0 1px 2px rgb(15 15 14 / 0.12), 0 30px 56px -26px rgb(15 15 14 / 0.45), inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }
  .fan-card--phone img {
    border-radius: calc(var(--dw) * 0.036 - 3px);
  }
  .fan-card--desk:hover,
  .fan-card--desk:focus-visible {
    z-index: 40;
    transform: var(--t) translateY(-6%);
    box-shadow: 0 2px 4px rgb(15 15 14 / 0.08), 0 44px 80px -28px rgb(15 15 14 / 0.55), 0 0 0 1px rgb(15 15 14 / 0.08);
  }
  .fan-name {
    position: absolute;
    left: 50%;
    top: -12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition: opacity 160ms var(--ease), transform 320ms var(--ease-spring);
    pointer-events: none;
  }
  .fan-card:hover .fan-name,
  .fan-card:focus-visible .fan-name {
    opacity: 1;
    transform: translate(-50%, -100%);
  }
  /* The cards start low but on screen, so the first paint already shows them
     and the largest image isn't held back by the animation. */
  @keyframes deal {
    from {
      transform: translate(0, 36%) rotate(0deg);
    }
  }
  @media (max-width: 820px) {
    .fan {
      --dw: 40vw;
    }
    /* On phones the hand is simply there: dealing it held back the first paint. */
    .fan-card {
      animation: none;
    }
  }
  @media (max-width: 560px) {
    .fan {
      --dw: 210px;
      height: 230px;
    }
    .fan-card {
      top: 1.25rem;
    }
  }
</style>
