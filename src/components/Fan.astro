---
// The hero's hand: Glen's client sites as desktop and phone pages along one
// shallow arc, desk, phone, desk, phone, the way Hallmark deals its themes.
// The script deals the hand up on arrival; a card lifts and names its site
// under the pointer, opens that site's page on this site, and "Deal again"
// gathers the hand and deals it in a new order. Without the script the hand
// sits on its arc. On a phone only the middle three cards are shown, and the
// rest are lazy, so they are never downloaded there.
import { clientSites } from '../lib/work';

const bySlug = Object.fromEntries(clientSites.map((c) => [c.slug, c]));
const deskOrder = ['gatfoundation', 'exitadvisory', 'ridgelineroofers', 'prefilters', 'brandoninsurance'];
const phoneOrder = ['prefilters', 'brandoninsurance', 'recovadapt', 'gatfoundation'];
// left to right: desk, phone, desk, phone ... desk
const row = deskOrder.flatMap((d, i) => [
  { slug: d, kind: 'desk', i },
  ...(phoneOrder[i] ? [{ slug: phoneOrder[i], kind: 'phone', i }] : []),
]);
const middle = new Set([3, 4, 5]);
const pool = clientSites.map((c) => ({ slug: c.slug, name: c.name }));
---
<div class="fan" data-fan>
  <div class="fan-hand" data-fan-hand>
    {row.map((c, k) => {
      const site = bySlug[c.slug];
      const lazy = middle.has(k) ? undefined : 'lazy';
      return c.kind === 'desk' ? (
        <a class:list={['card card--desk', { 'card--outer': !middle.has(k) }]} href={`/work/${c.slug}/`} data-slug={c.slug} data-kind="desk" style={`--i:${c.i}`}>
          <img
            src={`/work/clients/${c.slug}-desktop-600.webp`}
            srcset={`/work/clients/${c.slug}-desktop-600.webp 600w, /work/clients/${c.slug}-desktop-1200.webp 1200w`}
            sizes="(max-width: 560px) 230px, (max-width: 820px) 40vw, 540px"
            width="600"
            height="375"
            alt={`The ${site.name} website on a laptop`}
            loading={lazy}
            decoding="async"
          />
          <span class="card-name">{site.name}</span>
        </a>
      ) : (
        <a class:list={['card card--phone', { 'card--outer': !middle.has(k) }]} href={`/work/${c.slug}/`} data-slug={c.slug} data-kind="phone" style={`--i:${c.i}`}>
          <img
            src={`/work/clients/${c.slug}-phone-120.webp`}
            srcset={`/work/clients/${c.slug}-phone-120.webp 120w, /work/clients/${c.slug}-phone-240.webp 240w`}
            sizes="(max-width: 560px) 70px, 162px"
            width="120"
            height="260"
            alt={`The ${site.name} website on a phone`}
            loading={lazy}
            decoding="async"
          />
          <span class="card-name">{site.name}</span>
        </a>
      );
    })}
  </div>
  <button class="fan-deal" type="button" data-fan-deal>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 5.5h7.5a3 3 0 0 1 0 6H6.5M2.5 5.5L5 3M2.5 5.5L5 8" /></svg>
    <span>Deal again</span>
  </button>
  <script type="application/json" data-fan-pool set:html={JSON.stringify(pool)} />
</div>

<script>
  // Ported from Hallmark's js/fan.js: place each card along the arc, deal on
  // arrival, lift under the pointer, follow the pointer a little, deal again.
  const fan = document.querySelector<HTMLElement>('[data-fan]');
  if (fan) {
    const hero = fan.closest<HTMLElement>('.hero');
    const hand = fan.querySelector<HTMLElement>('[data-fan-hand]')!;
    const pool: { slug: string; name: string }[] = JSON.parse(fan.querySelector('[data-fan-pool]')!.textContent || '[]');
    const names = Object.fromEntries(pool.map((p) => [p.slug, p.name]));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const all = [...hand.querySelectorAll<HTMLAnchorElement>('.card')];
    // only the cards on screen take part (a phone shows the middle three)
    let row = all;
    let mid = 0;
    let up: HTMLElement | null = null;
    const refresh = () => {
      row = all.filter((c) => c.offsetParent !== null);
      mid = (row.length - 1) / 2;
    };

    const place = () => {
      const desk = row.find((c) => c.dataset.kind === 'desk');
      const phone = row.find((c) => c.dataset.kind === 'phone');
      const W = desk?.offsetWidth || 400;
      const P = phone ? phone.offsetWidth : W * 0.3;
      const gap = Math.max(14, W * 0.07);
      const xs: number[] = [];
      let x = 0;
      row.forEach((c, k) => {
        const w = c.dataset.kind === 'desk' ? W : P;
        if (k) x += gap;
        xs.push(x + w / 2);
        x += w;
      });
      const c0 = xs[Math.round(mid)];
      return { W, spots: row.map((c, k) => { const dx = xs[k] - c0; const u = dx / W; return { c, x: dx, y: u * u * W * 0.055, r: u * 2.9 }; }) };
    };
    const layout = () => {
      const { W, spots } = place();
      const ui = up ? row.indexOf(up as HTMLAnchorElement) : -1;
      spots.forEach(({ c, x, y, r }, k) => {
        if (ui >= 0) {
          if (k === ui) { y -= W * 0.1; r *= 0.4; }
          else x += Math.sign(k - ui) * W * (Math.abs(k - ui) === 1 ? 0.06 : 0.035);
        }
        c.style.setProperty('--t', `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) rotate(${r.toFixed(2)}deg)`);
        c.style.zIndex = String(20 - Math.round(Math.abs(k - mid) * 2));
        c.classList.toggle('is-up', c === up);
      });
    };
    const gather = () => row.forEach((c, k) => { c.style.setProperty('--t', `translate(${(k - mid) * 4}px, 170%) rotate(${(k - mid) * 1.2}deg)`); c.classList.remove('is-up'); });
    const deal = (delay = 0) => {
      row.forEach((c, k) => { c.style.transitionDelay = reduce ? '0ms' : `${delay + Math.abs(k - mid) * 55}ms`; });
      requestAnimationFrame(() => requestAnimationFrame(layout));
      setTimeout(() => row.forEach((c) => { c.style.transitionDelay = ''; }), delay + 1100);
    };

    refresh();
    requestAnimationFrame(() => requestAnimationFrame(() => hero?.classList.add('is-in')));
    if (reduce) layout(); else { gather(); deal(200); }

    const lift = (c: HTMLElement) => { if (c === up) return; up = c; layout(); };
    hand.addEventListener('pointerover', (e) => { const c = (e.target as HTMLElement).closest<HTMLElement>('.card'); if (c) lift(c); });
    hand.addEventListener('focusin', (e) => { const c = (e.target as HTMLElement).closest<HTMLElement>('.card'); if (c) lift(c); });
    hand.addEventListener('pointerleave', () => { up = null; layout(); });
    hand.addEventListener('focusout', (e) => { if (!hand.contains(e.relatedTarget as Node)) { up = null; layout(); } });
    let w0 = innerWidth;
    addEventListener('resize', () => { if (innerWidth === w0) return; w0 = innerWidth; refresh(); layout(); });

    if (!reduce && hero) hero.addEventListener('pointermove', (e) => {
      const dx = (e.clientX / innerWidth - 0.5) * 2;
      hand.style.transform = `translateX(${(dx * 10).toFixed(1)}px)`;
    });

    // deal again: the same sites in a new order, each card keeping its shape
    let busy = false;
    const btn = fan.querySelector<HTMLButtonElement>('[data-fan-deal]')!;
    btn.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      btn.setAttribute('aria-busy', 'true');
      const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [a[i], a[j]] = [a[j], a[i]]; } return a; };
      const desks = shuffle(pool.map((p) => p.slug));
      const phones = shuffle(pool.map((p) => p.slug));
      const next = row.map((c) => (c.dataset.kind === 'desk' ? desks.shift()! : phones.shift()!));
      const src = (c: HTMLElement, slug: string) => (c.dataset.kind === 'desk'
        ? { src: `/work/clients/${slug}-desktop-600.webp`, srcset: `/work/clients/${slug}-desktop-600.webp 600w, /work/clients/${slug}-desktop-1200.webp 1200w` }
        : { src: `/work/clients/${slug}-phone-120.webp`, srcset: `/work/clients/${slug}-phone-120.webp 120w, /work/clients/${slug}-phone-240.webp 240w` });
      up = null;
      row.forEach((c, k) => { c.style.transitionDelay = reduce ? '0ms' : `${(mid - Math.abs(k - mid)) * 30}ms`; });
      gather();
      await new Promise((r) => setTimeout(r, reduce ? 0 : 560));
      await Promise.all(row.map((c, k) => {
        const slug = next[k];
        const img = c.querySelector('img')!;
        const s = src(c, slug);
        c.dataset.slug = slug;
        c.href = `/work/${slug}/`;
        img.srcset = s.srcset;
        img.src = s.src;
        img.alt = `The ${names[slug]} website on a ${c.dataset.kind === 'desk' ? 'laptop' : 'phone'}`;
        c.querySelector('.card-name')!.textContent = names[slug];
        return img.decode ? img.decode().catch(() => {}) : null;
      }));
      deal(0);
      setTimeout(() => { busy = false; btn.removeAttribute('aria-busy'); }, 1000);
    });
  }
</script>

<style>
  .fan {
    --dw: clamp(200px, min(20vw + 90px, 46vh), 540px);
    position: relative;
    flex: 1;
    min-height: clamp(300px, 44vh, 470px);
    margin-top: 1.25rem;
  }
  .fan::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 25;
    height: 26%;
    background: linear-gradient(to bottom, transparent, var(--color-bg));
    pointer-events: none;
  }
  .fan-hand {
    position: absolute;
    left: 50%;
    top: 0;
    width: 0;
    height: 0;
    transition: transform 600ms var(--ease-out);
  }
  .card {
    position: absolute;
    top: 1.5rem;
    left: 0;
    display: block;
    text-decoration: none;
    transform-origin: 50% 100%;
    transform: var(--t);
    transition: transform 720ms var(--ease-spring), box-shadow 320ms var(--ease);
    will-change: transform;
  }
  .card--desk {
    width: var(--dw);
    aspect-ratio: 8 / 5;
    margin-left: calc(var(--dw) / -2);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .card--desk::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(15 15 14 / 0.08);
    pointer-events: none;
  }
  /* a slim device: thin graphite bezel and the island in the status bar */
  .card--phone {
    width: calc(var(--dw) * 0.3);
    aspect-ratio: 390 / 844;
    margin-left: calc(var(--dw) * -0.15);
    margin-top: calc(var(--dw) * -0.02);
    padding: 3px;
    border-radius: calc(var(--dw) * 0.036);
    background: oklch(24% 0.004 260);
    color: var(--color-bg);
    box-shadow: 0 1px 2px rgb(15 15 14 / 0.12), 0 30px 56px -26px rgb(15 15 14 / 0.45), inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }
  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    border-radius: inherit;
    pointer-events: none;
  }
  .card--phone img {
    border-radius: calc(var(--dw) * 0.036 - 3px);
  }
  /* without the script the hand still sits on its arc; the script deals it */
  .card--desk {
    --t: translate(calc((var(--i) - 2) * var(--dw) * 1.45), calc((var(--i) - 2) * (var(--i) - 2) * var(--dw) * 0.12)) rotate(calc((var(--i) - 2) * 4.2deg));
  }
  .card--phone {
    --t: translate(calc((var(--i) - 1.5) * var(--dw) * 1.45), calc((var(--i) - 1.5) * (var(--i) - 1.5) * var(--dw) * 0.12 - var(--dw) * 0.02)) rotate(calc((var(--i) - 1.5) * 4.2deg));
  }
  :global(.js) .card {
    --t: translate(0, 160%) rotate(0deg);
  }
  .card-name {
    position: absolute;
    left: 50%;
    top: -12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    transform: translate(-50%, 6px);
    transition: opacity 160ms var(--ease), transform 320ms var(--ease-spring);
    pointer-events: none;
  }
  :global(.js) .card-name {
    opacity: 0;
  }
  .card.is-up {
    z-index: 40 !important;
  }
  .card--desk.is-up {
    box-shadow: 0 2px 4px rgb(15 15 14 / 0.08), 0 44px 80px -28px rgb(15 15 14 / 0.55), 0 0 0 1px rgb(15 15 14 / 0.08);
  }
  .card.is-up .card-name,
  .card:focus-visible .card-name {
    opacity: 1;
    transform: translate(-50%, -100%);
  }
  .card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .fan-deal {
    position: absolute;
    right: var(--gutter, 1.5rem);
    bottom: 2rem;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 1rem 0 0.75rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-bg);
    box-shadow: var(--shadow-2);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform 160ms var(--ease), box-shadow 160ms var(--ease);
  }
  .fan-deal svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 500ms var(--ease-spring);
  }
  .fan-deal:hover svg {
    transform: rotate(-200deg);
  }
  .fan-deal:active {
    transform: scale(0.96);
  }
  /* dealing again needs the script */
  .fan-deal {
    display: none;
  }
  :global(.js) .fan-deal {
    display: inline-flex;
  }
  @media (max-height: 820px) and (min-width: 821px) {
    .fan {
      margin-top: 1rem;
    }
    .card {
      top: 1.5rem;
    }
  }
  @media (max-width: 820px) {
    .fan {
      --dw: 40vw;
      flex: none;
      min-height: 0;
      height: calc(var(--dw) * 0.92);
    }
    .fan-deal {
      bottom: auto;
      top: 0;
    }
  }
  @media (max-width: 560px) {
    .fan {
      --dw: 230px;
      height: 240px;
      margin-top: 2rem;
    }
    .card {
      top: 1rem;
    }
    .card--outer {
      display: none;
    }
    /* under the hand, clear of the cards */
    .fan {
      height: 300px;
    }
    .fan-deal {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: max-content;
      margin-inline: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .fan-hand {
      transition: none;
    }
  }
</style>
