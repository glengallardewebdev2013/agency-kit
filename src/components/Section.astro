---
interface Props { heading?: string; intro?: string; id?: string; tone?: 'plain' | 'surface' }
const { heading, intro, id, tone = 'plain' } = Astro.props;
---
<section id={id} class:list={['py-16', tone === 'surface' && 'bg-surface']}>
  <div class="container-site">
    {heading && <h2 class="text-3xl font-bold">{heading}</h2>}
    {intro && <p class="mt-3 max-w-2xl text-muted">{intro}</p>}
    <div class:list={[heading || intro ? 'mt-8' : '']}><slot /></div>
  </div>
</section>
