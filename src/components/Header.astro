---
import Logo from './Logo.astro';
import { nav } from '../lib/nav';
const current = Astro.url.pathname;
---
<header class="bg-bg">
  <div class="container-site flex min-h-20 items-center justify-between gap-4 py-4">
    <a href="/" class="text-ink no-underline hover:text-ink" aria-label="GallarDesign home"><Logo /></a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[0.95rem] font-medium">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['no-underline', current.startsWith(item.href) && 'text-mark']}
              aria-current={current.startsWith(item.href) ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href="/contact/" class="btn btn-primary hidden sm:inline-flex">Start a project</a>
      <details class="relative lg:hidden">
        <summary class="btn cursor-pointer list-none bg-surface px-4 text-ink">Menu</summary>
        <nav aria-label="Mobile" class="absolute right-0 z-10 mt-2 w-60 bg-ink p-2 text-bg">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} class="block px-3 py-2.5 no-underline hover:text-bg hover:underline">{item.label}</a></li>
            ))}
            <li><a href="/contact/" class="block px-3 py-2.5 font-semibold no-underline hover:text-bg hover:underline">Start a project</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
