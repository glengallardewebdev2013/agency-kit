---
import { clientSites } from '../lib/work';
---
<ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {clientSites.map((c) => (
    <li class="client tile relative flex flex-col p-6">
      <div class="shot" aria-hidden="true">
        <img
          class="shot-desk"
          src={`/work/clients/${c.slug}-desktop-600.webp`}
          srcset={`/work/clients/${c.slug}-desktop-600.webp 600w, /work/clients/${c.slug}-desktop-1200.webp 1200w`}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
          width="600"
          height="375"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <img
          class="shot-phone"
          src={`/work/clients/${c.slug}-phone-120.webp`}
          srcset={`/work/clients/${c.slug}-phone-120.webp 120w, /work/clients/${c.slug}-phone-240.webp 240w`}
          sizes="80px"
          width="120"
          height="260"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="label mt-6">{c.kind} · {c.where}</p>
      <h3 class="mt-3 text-[1.625rem] [font-family:var(--font-display)] !font-normal tracking-[-0.02em]">
        <a href={c.url} rel="noopener" target="_blank" class="no-underline after:absolute after:inset-0 after:rounded-site">{c.name}<span class="sr-only"> (opens in a new tab)</span></a>
      </h3>
      <p class="mt-2 text-[0.9375rem] text-muted">{c.note}</p>
      <span class="mt-auto pt-6 text-[0.9375rem] font-medium" aria-hidden="true">Visit the site <span class="arrow">↗</span></span>
    </li>
  ))}
</ul>

<style>
  /* The home page on a laptop, with the phone view leaning on its corner. */
  .shot {
    position: relative;
    margin-bottom: 1rem;
  }
  .shot-desk {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-in);
    box-shadow: 0 0 0 1px var(--color-line);
  }
  .shot-phone {
    position: absolute;
    right: 0.75rem;
    bottom: -1rem;
    width: 22%;
    height: auto;
    aspect-ratio: 390 / 844;
    object-fit: cover;
    object-position: top;
    border: 3px solid oklch(24% 0.004 260);
    border-radius: 12px;
    box-shadow: 0 1px 2px rgb(15 15 14 / 0.12), 0 18px 32px -16px rgb(15 15 14 / 0.45);
  }
  .client {
    transition: box-shadow 320ms var(--ease), background-color 320ms var(--ease);
  }
  .client:hover {
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-ink), var(--shadow-2);
  }
  .arrow {
    display: inline-block;
    transition: transform 320ms var(--ease-spring);
  }
  .client:hover .arrow {
    transform: translate(2px, -2px);
  }
</style>
