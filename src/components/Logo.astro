---
// The GallarDesign wordmark: the name in Fraunces, nothing else (Glen dropped
// the G/D monogram on 2026-10-28). Outlined SVG files are in brand/.
interface Props { size?: string; class?: string }
const { size = '1.625rem', class: className } = Astro.props;
---
<span class:list={['lockup', className]} style={`font-size:${size}`}>GallarDesign</span>

<style>
  .lockup {
    display: inline-block;
    color: inherit;
    font-family: var(--font-brand);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
</style>
