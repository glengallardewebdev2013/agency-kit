---
import { lowBudget } from '../lib/pricing';
---
<div class="grid gap-5 md:grid-cols-3">
  {lowBudget.map((o) => (
    <div class="tile flex flex-col p-6">
      <h3 class="text-[1.0625rem]">{o.name}</h3>
      <p class="figure mt-4 text-[2rem]">{o.price}</p>
      <p class="mt-4 text-[0.9375rem] text-muted">{o.text}</p>
    </div>
  ))}
</div>
