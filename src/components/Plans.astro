---
import { featuredPlan, peso, plans, previewDays } from '../lib/pricing';
---
<div class="grid items-stretch gap-5 md:grid-cols-3">
  {plans.map((p) => {
    const featured = p.name === featuredPlan;
    return (
      <article class:list={['flex flex-col gap-6 rounded-site p-6 md:p-8', featured ? 'field shadow-[var(--shadow-card)]' : 'tile']} aria-labelledby={`plan-${p.name}`}>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 id={`plan-${p.name}`} class="text-[1.0625rem]">{p.name}</h3>
          {featured && <span class="chip !bg-field-ink !text-ink !shadow-none"><span class="chip-dot" aria-hidden="true"></span>Most clients pick this</span>}
        </div>
        <p>
          <span class="figure block text-[clamp(3.25rem,2.6rem+2vw,4.5rem)]">{peso(p.price)}</span>
          <span class="label mt-3 block">once, only if you love the preview</span>
        </p>
        <p class="text-[0.9375rem] text-muted">{p.summary}</p>
        <ul class="space-y-2 border-t border-line pt-6 text-[0.9375rem]">
          {p.includes.map((i) => (
            <li class="flex gap-3">
              <svg class="mt-[0.3em] h-3.5 w-3.5 flex-none text-accent" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{i}</span>
            </li>
          ))}
        </ul>
        <p class="label mt-auto">Best for: {p.bestFor}</p>
        <a href="/contact/" class:list={['btn', featured ? 'btn-primary' : 'btn-secondary']}>Get a free {p.name} preview</a>
      </article>
    );
  })}
</div>
<p class="mt-6 text-[0.9375rem] text-muted">Free preview in {previewDays} working days. Pay in full by GCash, Maya, bank transfer or card. Care is optional.</p>
