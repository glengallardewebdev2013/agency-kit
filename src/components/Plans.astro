---
import { featuredPlan, money, plans } from '../lib/pricing';
interface Props { detail?: boolean }
const { detail = false } = Astro.props;
---
<div class="grid items-stretch gap-5 md:grid-cols-3">
  {plans.map((p) => {
    const featured = p.name === featuredPlan;
    return (
      <article class:list={['flex flex-col gap-6 rounded-site p-6 md:p-8', featured ? 'field shadow-[var(--shadow-card)]' : 'tile']} aria-labelledby={`plan-${p.name}`}>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 id={`plan-${p.name}`} class="text-[1.0625rem]">{p.name}</h3>
          {featured && <span class="chip !bg-field-ink !text-ink !shadow-none"><span class="chip-dot" aria-hidden="true"></span>Best for most businesses</span>}
        </div>
        <p>
          <span class="figure block text-[clamp(3.5rem,3rem+2vw,4.75rem)]">{money(p.monthly)}</span>
          <span class="label mt-3 block">a month for 12 months, $0 down</span>
        </p>
        <p class="text-[0.9375rem] text-muted">{p.summary}</p>
        <ul class="space-y-2 border-t border-line pt-6 text-[0.9375rem]">
          {p.includes.map((i) => (
            <li class="flex gap-3">
              <svg class="mt-[0.3em] h-3.5 w-3.5 flex-none text-accent" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{i}</span>
            </li>
          ))}
        </ul>
        {detail && (
          <dl class="mt-auto grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 border-t border-line pt-6 text-[0.9375rem]">
            <dt class="label self-center">Or upfront</dt><dd>{money(p.upfront)} once</dd>
            <dt class="label self-center">From month 13</dt><dd>{p.care}</dd>
            <dt class="label self-center">Early buyout</dt><dd>{money(p.buyout)} per month left</dd>
          </dl>
        )}
        <a href="/contact/" class:list={['btn mt-auto', featured ? 'btn-primary' : 'btn-secondary', detail && '!mt-0']}>Start on {p.name}</a>
      </article>
    );
  })}
</div>
