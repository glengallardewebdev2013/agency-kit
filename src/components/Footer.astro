---
import Logo from './Logo.astro';
import { settings } from '../lib/settings';
import { nav } from '../lib/nav';
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-ink text-bg">
  <div class="container-site grid gap-12 py-16 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo size="1.5rem" />
      {settings.tagline && <p class="mt-6 max-w-xs text-xl">{settings.tagline}</p>}
    </div>
    <div class="md:col-span-3">
      <p class="label !text-bg/70">Contact</p>
      <ul class="mt-3 space-y-1">
        {settings.email && <li><a href={`mailto:${settings.email}`} class="hover:text-bg">{settings.email}</a></li>}
        {settings.phone && <li><a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`} class="hover:text-bg">{settings.phone}</a></li>}
        {settings.hours && <li>{settings.hours}</li>}
      </ul>
    </div>
    <nav aria-label="Footer" class="md:col-span-4">
      <p class="label !text-bg/70">Pages</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1">
        {nav.map((item) => <li><a href={item.href} class="no-underline hover:text-bg hover:underline">{item.label}</a></li>)}
        <li><a href="/contact/" class="no-underline hover:text-bg hover:underline">Contact</a></li>
      </ul>
    </nav>
  </div>
  <div class="container-site pb-10 text-sm text-bg/70">
    <p>Copyright {year} {settings.name}. You own your content and domain from day one.</p>
  </div>
</footer>
