---
// The close of the home page, as on Hallmark's "Made with Hallmark": the work
// on a 3D wheel on ink, joined to the call to action and footer below. Drag or
// swipe to turn it, use the arrows or the keyboard, or click a page at the side
// to bring it round. The page in front opens its page on this site. While
// nobody touches it, the wheel turns slowly on its own.
import { clientSites, concepts } from '../lib/work';
const cards = [
  ...clientSites.map((c) => ({ href: `/work/${c.slug}/`, name: c.name, meta: c.kind, src: `/work/clients/${c.slug}-desktop`, alt: `The ${c.name} home page` })),
  ...concepts.map((c) => ({ href: '/work/', name: c.name, meta: `Design sample: ${c.kind.toLowerCase()}`, src: `/work/${c.slug}`, alt: c.alt })),
];
// the concept files are named <slug>-600.webp and <slug>.webp (1200w)
const set = (src: string, client: boolean) => (client
  ? { src: `${src}-600.webp`, srcset: `${src}-600.webp 600w, ${src}-1200.webp 1200w` }
  : { src: `${src}-600.webp`, srcset: `${src}-600.webp 600w, ${src}.webp 1200w` });
---
<section class="made field" aria-labelledby="made-title">
  <div class="container-site">
    <div class="head">
      <h2 id="made-title" class="h2">Made by GallarDesign</h2>
      <p class="head-sub">Client sites Glen designed and built, and design samples for Cebu businesses. Drag the wheel to look around.</p>
    </div>
  </div>
  <div class="wheel" data-wheel tabindex="0" role="region" aria-roledescription="carousel" aria-label="Our work; left and right arrows turn the wheel">
    <div class="wheel-stage">
      <ul class="wheel-ring" data-wheel-ring style={`--n:${cards.length}`}>
        {cards.map((c, k) => {
          const s = set(c.src, k < clientSites.length);
          return (
            <li class="wheel-item" style={`--k:${k}`}>
              <a class="wheel-card" href={c.href} data-name={c.name} data-meta={c.meta} draggable="false">
                <img src={s.src} srcset={s.srcset} sizes="(max-width: 560px) 78vw, 600px" width="600" height="375" alt={c.alt} loading="lazy" decoding="async" draggable="false" />
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
  <div class="container-site wheel-bar">
    <button class="wheel-btn" type="button" data-wheel-prev aria-label="Previous site"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg></button>
    <p class="wheel-cap" aria-live="polite" data-wheel-cap><a href={cards[0].href}><b>{cards[0].name}</b> <span>{cards[0].meta}</span></a></p>
    <button class="wheel-btn" type="button" data-wheel-next aria-label="Next site"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></button>
  </div>
</section>

<script>
  // Ported from Hallmark's js/wheel.js.
  const wheel = document.querySelector<HTMLElement>('[data-wheel]');
  if (wheel) {
    const ring = wheel.querySelector<HTMLElement>('[data-wheel-ring]')!;
    const cards = [...ring.querySelectorAll<HTMLAnchorElement>('.wheel-card')];
    const n = cards.length;
    const step = 360 / n;
    const cap = document.querySelector<HTMLElement>('[data-wheel-cap]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let turn = 0, vel = 0, target: number | null = null, drag = false, lastX = 0, lastT = 0, moved = 0, idle = !reduce, front = -1, raf = 0, visible = false;

    const radius = () => {
      const w = wheel.querySelector('.wheel-stage')!.getBoundingClientRect().width;
      wheel.style.setProperty('--r3d', `${(w / 2 + Math.max(16, w * 0.04)) / Math.tan(Math.PI / n)}px`);
    };
    radius();
    addEventListener('resize', radius);

    const frontOf = (t: number) => ((Math.round(-t / step) % n) + n) % n;
    const paint = () => {
      ring.style.setProperty('--turn', `${turn}deg`);
      cards.forEach((c, k) => {
        const a = ((((k * step + turn) % 360) + 540) % 360) - 180; // angle from the front, -180..180
        const d = Math.min(1, Math.abs(a) / 80);
        c.style.filter = `brightness(${1 - d * 0.55}) saturate(${1 - d * 0.3})`;
        c.style.setProperty('--lift', `${(1 - Math.min(1, Math.abs(a) / step)) * 90}px`);
        c.tabIndex = Math.abs(a) < step / 2 ? 0 : -1;
      });
      const f = frontOf(turn);
      if (f !== front) {
        front = f;
        const c = cards[f];
        cap.innerHTML = '';
        const a = document.createElement('a');
        a.href = c.getAttribute('href') || '/work/';
        const b = document.createElement('b');
        b.textContent = c.dataset.name || '';
        const s = document.createElement('span');
        s.textContent = c.dataset.meta || '';
        a.append(b, ' ', s);
        cap.append(a);
      }
    };
    const loop = () => {
      raf = 0;
      if (drag) { paint(); raf = requestAnimationFrame(loop); return; }
      if (target !== null) {
        const d = target - turn;
        turn += d * 0.14;
        if (Math.abs(d) < 0.05) { turn = target; target = null; }
      } else if (Math.abs(vel) > 0.02) {
        turn += vel;
        vel *= 0.93;
        if (Math.abs(vel) <= 0.02) target = Math.round(turn / step) * step;
      } else if (idle && visible) {
        turn -= 0.06;
      }
      paint();
      if (target !== null || Math.abs(vel) > 0.02 || (idle && visible)) raf = requestAnimationFrame(loop);
    };
    const go = () => { if (!raf) raf = requestAnimationFrame(loop); };
    const to = (k: number) => {
      idle = false;
      vel = 0;
      const cur = Math.round(-turn / step);
      let d = (((k - cur) % n) + n) % n;
      if (d > n / 2) d -= n;
      target = -(cur + d) * step;
      go();
    };
    paint();

    if ('IntersectionObserver' in window) new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (visible) go(); }, { threshold: 0.2 }).observe(wheel);

    wheel.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      drag = true; idle = false; target = null; vel = 0; moved = 0; lastX = e.clientX; lastT = performance.now();
      wheel.classList.add('is-drag');
      try { wheel.setPointerCapture(e.pointerId); } catch {}
      go();
    });
    wheel.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const now = performance.now();
      const dx = e.clientX - lastX;
      const deg = dx * (step / (cards[0].offsetWidth * 0.9));
      turn += deg;
      moved += Math.abs(dx);
      vel = (deg / Math.max(1, now - lastT)) * 16;
      lastX = e.clientX;
      lastT = now;
    });
    const release = () => {
      if (!drag) return;
      drag = false;
      wheel.classList.remove('is-drag');
      if (Math.abs(vel) < 0.3) { vel = 0; target = Math.round(turn / step) * step; }
      go();
    };
    wheel.addEventListener('pointerup', release);
    wheel.addEventListener('pointercancel', release);
    wheel.addEventListener('lostpointercapture', release);

    // a drag never opens a page; a click on a side page brings it round instead
    wheel.addEventListener('click', (e) => {
      const c = (e.target as HTMLElement).closest<HTMLAnchorElement>('.wheel-card');
      if (!c) return;
      if (moved > 6) { e.preventDefault(); return; }
      const k = cards.indexOf(c);
      if (k !== frontOf(turn)) { e.preventDefault(); to(k); }
    }, true);

    // a horizontal swipe on a trackpad turns it too
    wheel.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      e.preventDefault();
      idle = false;
      target = null;
      vel = -e.deltaX * 0.02;
      go();
    }, { passive: false });

    wheel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); to(frontOf(turn) + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); to(frontOf(turn) - 1); }
    });
    cards.forEach((c, k) => c.addEventListener('focus', () => { if (k !== frontOf(turn)) to(k); }));
    document.querySelector('[data-wheel-prev]')!.addEventListener('click', () => to(frontOf(turn) - 1));
    document.querySelector('[data-wheel-next]')!.addEventListener('click', () => to(frontOf(turn) + 1));
  }
</script>

<style>
  .made {
    margin-top: var(--section-gap);
    padding-top: 8rem;
    overflow: clip;
  }
  .made .head-sub {
    color: var(--color-field-muted);
  }
  .wheel {
    --cw: clamp(280px, 30vw + 80px, 600px);
    --r3d: calc((var(--cw) / 2 + 24px) / tan(18deg));
    position: relative;
    height: calc(var(--cw) * 0.625 + 120px);
    margin-top: -2rem;
    perspective: 1500px;
    perspective-origin: 50% 35%;
    cursor: grab;
    touch-action: pan-y;
    outline: none;
  }
  .wheel::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 34%;
    width: min(1400px, 110vw);
    height: 72%;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgb(252 76 2 / 0.14), transparent);
    pointer-events: none;
  }
  .wheel:focus-visible .wheel-stage {
    outline: 2px solid var(--color-accent);
    outline-offset: 12px;
    border-radius: var(--radius);
  }
  .wheel:global(.is-drag) {
    cursor: grabbing;
  }
  .wheel-stage {
    position: absolute;
    left: 50%;
    top: 40px;
    width: var(--cw);
    aspect-ratio: 16 / 10;
    margin-left: calc(var(--cw) / -2);
    transform-style: preserve-3d;
  }
  .wheel-ring {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r3d) * -1)) rotateX(-3deg) rotateY(var(--turn, 0deg));
    will-change: transform;
  }
  .wheel-item {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--k) * 360deg / var(--n))) translateZ(var(--r3d));
    backface-visibility: hidden;
  }
  .wheel-card {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: #1c1c1a;
    box-shadow: 0 0 0 1px rgb(245 245 243 / 0.12), 0 40px 80px -30px rgb(0 0 0 / 0.9);
    transform: translateZ(var(--lift, 0px));
    backface-visibility: hidden;
    transition: filter 300ms var(--ease);
    -webkit-box-reflect: below 14px linear-gradient(transparent 72%, rgb(255 255 255 / 0.13));
  }
  .wheel-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
  }
  .wheel-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .wheel-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .wheel-btn {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: #1c1c1a;
    color: #f5f5f3;
    box-shadow: inset 0 0 0 1px rgb(245 245 243 / 0.22);
    cursor: pointer;
    transition: background-color 160ms var(--ease), box-shadow 160ms var(--ease);
  }
  .wheel-btn:hover {
    background: #262624;
    box-shadow: inset 0 0 0 1px #c9c9c4;
  }
  .wheel-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wheel-cap {
    flex: 0 1 20rem;
    min-width: 0;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-field-muted);
  }
  .wheel-cap :global(a) {
    color: inherit;
    text-decoration: none;
  }
  .wheel-cap :global(a:hover b) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .wheel-cap :global(b) {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-field-ink);
  }
  @media (max-width: 560px) {
    .wheel {
      --cw: 78vw;
    }
  }
</style>
