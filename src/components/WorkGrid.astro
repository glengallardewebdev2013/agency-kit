---
// The work, as a grid of home pages in the manner of Hallmark's theme gallery:
// a pill filter above, five across on a laptop. Client sites open their page on
// this site; design samples are concepts and say so.
import { clientSites, concepts, photoCredits } from '../lib/work';
const items = [
  ...clientSites.map((c) => ({ kind: 'client', name: c.name, meta: c.kind, href: `/work/${c.slug}/`, src: `/work/clients/${c.slug}-desktop-600.webp`, alt: `The ${c.name} home page` })),
  ...concepts.map((c) => ({ kind: 'sample', name: c.name, meta: `Design sample: ${c.kind.toLowerCase()}`, href: undefined, src: `/work/${c.slug}-600.webp`, alt: c.alt })),
];
const counts = { all: items.length, client: clientSites.length, sample: concepts.length };
---
<div class="wg" data-wg>
  <div class="seg" role="group" aria-label="Filter the work">
    <button type="button" class="pill" aria-pressed="true" data-wg-show="all">All <span class="pill-n">{counts.all}</span></button>
    <button type="button" class="pill" aria-pressed="false" data-wg-show="client">Client sites <span class="pill-n">{counts.client}</span></button>
    <button type="button" class="pill" aria-pressed="false" data-wg-show="sample">Design samples <span class="pill-n">{counts.sample}</span></button>
  </div>
  <ul class="wg-grid">
    {items.map((it) => (
      <li class="wg-item" data-kind={it.kind}>
        {it.href ? (
          <a class="wg-link" href={it.href}>
            <span class="wg-shot"><img src={it.src} width="600" height="375" alt={it.alt} loading="lazy" decoding="async" /></span>
            <span class="wg-name">{it.name}</span>
            <span class="wg-meta">{it.meta}</span>
          </a>
        ) : (
          <div class="wg-link">
            <span class="wg-shot"><img src={it.src} width="600" height="375" alt={it.alt} loading="lazy" decoding="async" /></span>
            <span class="wg-name">{it.name}</span>
            <span class="wg-meta">{it.meta}</span>
          </div>
        )}
      </li>
    ))}
  </ul>
  <p class="mt-10 max-w-3xl text-[0.8125rem] text-muted">
    Design samples are concept sites for made-up businesses, made to show the range. They are not client work.
    Photographs in them: {photoCredits.map((p, i) => <><a href={p.href} rel="noopener">{p.by}</a> ({p.license}){i < photoCredits.length - 1 ? ', ' : ''}</>)}, via Wikimedia Commons.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-wg]').forEach((root) => {
    const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-wg-show]')];
    const items = [...root.querySelectorAll<HTMLElement>('.wg-item')];
    pills.forEach((p) =>
      p.addEventListener('click', () => {
        const show = p.dataset.wgShow;
        pills.forEach((q) => q.setAttribute('aria-pressed', String(q === p)));
        items.forEach((it) => (it.hidden = show !== 'all' && it.dataset.kind !== show));
      }),
    );
  });
</script>

<style>
  .seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 2rem;
    padding: 4px;
    border-radius: 999px;
    background: var(--color-surface);
  }
  .seg .pill {
    min-height: 34px;
  }
  .seg .pill:hover {
    background: var(--color-bg);
  }
  .seg .pill[aria-pressed='true'] {
    background: var(--color-bg);
    color: var(--color-ink);
    box-shadow: var(--shadow-1);
  }
  .pill-n {
    font-size: 0.8125rem;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
  .wg-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }
  .wg-item[hidden] {
    display: none;
  }
  .wg-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .wg-shot {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow-1);
    transition: box-shadow 320ms var(--ease);
  }
  .wg-shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    object-position: top;
  }
  a.wg-link:hover .wg-shot {
    box-shadow: 0 0 0 2px var(--color-ink);
  }
  a.wg-link:focus-visible {
    outline: none;
  }
  a.wg-link:focus-visible .wg-shot {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .wg-name {
    display: block;
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .wg-meta {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  @media (max-width: 1100px) {
    .wg-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .wg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 0.75rem;
    }
  }
  @media (max-width: 560px) {
    .seg {
      flex-wrap: nowrap;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .seg .pill {
      flex: none;
    }
  }
</style>
