---
import { care, peso } from '../lib/pricing';
---
<div class="grid gap-5 md:grid-cols-3">
  {care.map((c) => (
    <div class="tile flex flex-col p-6">
      <h3 class="text-[1.0625rem]">{c.name}</h3>
      <p class="mt-4"><span class="figure text-[2.75rem]">{peso(c.monthly)}</span><span class="label ml-1">a month</span></p>
      <p class="mt-4 text-[0.9375rem] text-muted">{c.includes}</p>
    </div>
  ))}
</div>
<p class="mt-6 max-w-3xl text-[0.9375rem] text-muted">Month to month, cancel with 30 days' notice. Prepay 12 months and get 2 free. No care plan? We move the site to a free Cloudflare account in your name and hand over everything. You only pay for your domain.</p>
