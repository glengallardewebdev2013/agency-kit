---
import { getIndustries } from '../lib/content';
// A concept site that suits each industry, shown as its picture.
const pictures: Record<string, string> = { 'med-spas': 'spa', 'home-improvement': 'remodel' };
const industries = await getIndustries();
---
<ul class="grid gap-5 md:grid-cols-2">
  {industries.map((i) => (
    <li class="ind relative">
      {pictures[i.id] && <span class="shot"><img src={`/work/${pictures[i.id]}.webp`} width="1200" height="750" alt="" loading="lazy" decoding="async" /></span>}
      <h3 class="mt-5 text-[1.625rem] [font-family:var(--font-display)] !font-normal tracking-[-0.02em]">
        <a href={`/industries/${i.id}/`} class="no-underline after:absolute after:inset-0">{i.data.title}</a>
      </h3>
      <p class="mt-2 max-w-[48ch] text-[0.9375rem] text-muted">{i.data.summary}</p>
      <span class="mt-4 inline-block text-[0.9375rem] font-medium" aria-hidden="true">See what's included <span class="arrow">→</span></span>
    </li>
  ))}
</ul>

<style>
  .shot {
    transition: box-shadow 320ms var(--ease);
  }
  .ind:hover .shot {
    box-shadow: 0 0 0 2px var(--color-ink);
  }
  .arrow {
    display: inline-block;
    transition: transform 320ms var(--ease-spring);
  }
  .ind:hover .arrow {
    transform: translateX(4px);
  }
</style>
