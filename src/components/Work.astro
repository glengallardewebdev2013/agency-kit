---
import { concepts, photoCredits } from '../lib/work';
---
<ul class="grid gap-x-5 gap-y-10 sm:grid-cols-2">
  {concepts.map((c) => (
    <li>
      <figure>
        <div class="grid grid-cols-[minmax(0,1fr)_22%] items-end gap-3">
          <span class="shot"><img src={`/work/${c.slug}.webp`} width="1200" height="750" alt={c.alt} loading="lazy" decoding="async" /></span>
          <span class="shot !rounded-[10px]"><img src={`/work/${c.slug}-phone.webp`} width="390" height="844" alt="" loading="lazy" decoding="async" /></span>
        </div>
        <figcaption class="mt-3 flex flex-wrap items-baseline gap-x-3 text-[0.9375rem]">
          <span class="font-medium">{c.name}</span><span class="text-muted">Concept for a {c.kind.toLowerCase()}</span>
        </figcaption>
      </figure>
    </li>
  ))}
</ul>
<p class="mt-10 max-w-3xl text-[0.8125rem] text-muted">
  These are concept sites for made-up businesses, designed to show the range. They are not client work.
  Photographs: {photoCredits.map((p, i) => <><a href={p.href} rel="noopener">{p.by}</a> ({p.license}){i < photoCredits.length - 1 ? ', ' : ''}</>)}, via Wikimedia Commons.
</p>
