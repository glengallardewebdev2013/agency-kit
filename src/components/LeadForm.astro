---
import { settings } from '../lib/settings';
import { HONEYPOT_FIELD } from '../lib/lead';
interface Props { id?: string; heading?: string; formName?: string; showMessage?: boolean; submitLabel?: string }
const { id = 'lead-form', heading, formName = 'contact', showMessage = true, submitLabel = 'Send request' } = Astro.props;
const tel = settings.phone.replace(/[^\d+]/g, '');
const input = 'mt-1 block w-full rounded-site border border-line bg-bg px-3 py-2 text-ink';
---
<form id={id} action="/api/lead" method="post" class="lead-form max-w-xl space-y-4" data-success={settings.formSuccessMessage} novalidate>
  {heading && <h2 class="text-2xl font-bold">{heading}</h2>}
  <input type="hidden" name="form" value={formName} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <div aria-hidden="true" class="absolute -left-[9999px]">
    <label>Leave this empty <input type="text" name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" /></label>
  </div>
  <div>
    <label for={`${id}-name`} class="font-semibold">Name</label>
    <input id={`${id}-name`} name="name" type="text" autocomplete="name" required class={input} />
  </div>
  <div>
    <label for={`${id}-email`} class="font-semibold">Email</label>
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" class={input} />
  </div>
  <div>
    <label for={`${id}-phone`} class="font-semibold">Phone</label>
    <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" class={input} />
  </div>
  {showMessage && (
    <div>
      <label for={`${id}-message`} class="font-semibold">How can we help?</label>
      <textarea id={`${id}-message`} name="message" rows="4" class={input}></textarea>
    </div>
  )}
  <p class="text-sm text-muted">We need your name and an email or phone number.</p>
  <button type="submit" class="btn btn-primary">{submitLabel}</button>
  <div class="form-status" role="status" aria-live="polite"></div>
  <template class="form-error-fallback">
    {settings.phone && <> Please call <a href={`tel:${tel}`}>{settings.phone}</a></>}
    {settings.phone && settings.email && ' or '}
    {settings.email && <> email <a href={`mailto:${settings.email}`}>{settings.email}</a></>}
    {(settings.phone || settings.email) && '.'}
  </template>
</form>

<script>
  type Gtag = (...args: unknown[]) => void;
  interface TrackingWindow {
    dataLayer?: unknown[];
    gtag?: Gtag;
    fbq?: Gtag;
    __adsLeadSendTo?: string;
  }

  function trackLead(formName: string) {
    const w = window as unknown as TrackingWindow;
    (w.dataLayer ??= []).push({ event: 'generate_lead', form_name: formName });
    if (w.fbq) w.fbq('track', 'Lead');
    if (w.gtag && w.__adsLeadSendTo) w.gtag('event', 'conversion', { send_to: w.__adsLeadSendTo });
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('form.lead-form')) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const fallback = form.querySelector<HTMLTemplateElement>('.form-error-fallback');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      status.className = 'form-status text-muted';
      status.textContent = 'Sending…';
      const data = new FormData(form);
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { accept: 'application/json' } });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (!res.ok || !body.ok) throw new Error(body.error || 'We could not send your message.');
        form.reset();
        status.className = 'form-status font-semibold text-success';
        status.textContent = form.dataset.success ?? 'Thanks, your message was sent.';
        trackLead(String(data.get('form') ?? 'contact'));
      } catch (err) {
        status.className = 'form-status font-semibold text-danger';
        status.textContent = `${err instanceof Error ? err.message : 'Something went wrong.'}`;
        if (fallback) status.append(fallback.content.cloneNode(true));
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
