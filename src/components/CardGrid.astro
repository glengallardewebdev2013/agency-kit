---
interface Card { title: string; text: string; href?: string }
interface Props { cards: Card[] }
const { cards } = Astro.props;
---
<ul class="grid gap-5 [grid-template-columns:repeat(auto-fill,minmax(min(100%,16rem),1fr))]">
  {cards.map((c) => (
    <li class:list={['card tile relative flex flex-col p-6', c.href && 'card--link']}>
      <h3 class="text-[1.375rem] [font-family:var(--font-display)] !font-normal tracking-[-0.02em]">
        {c.href ? <a href={c.href} class="no-underline after:absolute after:inset-0 after:rounded-site">{c.title}</a> : c.title}
      </h3>
      <p class="mt-2 text-[0.9375rem] text-muted">{c.text}</p>
      {c.href && <span class="mt-auto pt-6 text-[0.9375rem] font-medium" aria-hidden="true">Read more <span class="arrow">→</span></span>}
    </li>
  ))}
</ul>

<style>
  .card--link {
    transition: box-shadow 320ms var(--ease), background-color 320ms var(--ease);
  }
  .card--link:hover {
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-ink), var(--shadow-2);
  }
  .arrow {
    display: inline-block;
    transition: transform 320ms var(--ease-spring);
  }
  .card--link:hover .arrow {
    transform: translateX(4px);
  }
</style>
