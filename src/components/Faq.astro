---
import type { Faq } from '../lib/types';
interface Props { items: Faq[] }
const items = Astro.props.items.filter((f) => f.question.trim() && f.answer.trim());
---
{items.length > 0 && (
  <div class="faq-list">
    {items.map((f) => (
      <details>
        <summary>{f.question}<span class="faq-mark" aria-hidden="true"></span></summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </div>
)}
