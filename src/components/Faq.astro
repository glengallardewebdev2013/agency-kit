---
import type { Faq } from '../lib/types';
interface Props { items: Faq[] }
const items = Astro.props.items.filter((f) => f.question.trim() && f.answer.trim());
---
{items.length > 0 && (
  <div class="max-w-3xl divide-y divide-line border-y border-line">
    {items.map((f) => (
      <details class="group py-4">
        <summary class="cursor-pointer list-none font-semibold">{f.question}</summary>
        <p class="mt-2 text-muted">{f.answer}</p>
      </details>
    ))}
  </div>
)}
