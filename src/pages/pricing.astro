---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Plans from '../components/Plans.astro';
import Care from '../components/Care.astro';
import LowBudget from '../components/LowBudget.astro';
import PreviewRules from '../components/PreviewRules.astro';
import Pledge from '../components/Pledge.astro';
import Founding from '../components/Founding.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqSchema } from '../lib/schema';
import { peso, plans } from '../lib/pricing';

const faqs = [
  { question: 'Is there a deposit?', answer: "No. We build your preview first. You pay the one-time price in full only when you've seen the site and want to keep it." },
  { question: 'What happens after I pay?', answer: 'Your site goes live on your domain within 2 working days. The domain is registered in your name, and you get every file and login.' },
  { question: 'What does a revision round mean?', answer: `One set of changes you send together, after you see the preview. Starter includes 1 round, Business 2 and Growth 3. Extra pages are ${peso(3000)} each.` },
  { question: 'Is there anything else to pay?', answer: 'Only your domain name, about ₱700 a year for a .com, at cost and in your name. We show you the renewal price before you buy. Care is optional.' },
  { question: 'Do you give official receipts?', answer: 'Yes, for every payment, by GCash, Maya, bank transfer or card.' },
  { question: 'What if something breaks after launch?', answer: 'Any bug in the first 30 days is fixed free, with or without a care plan.' },
];
---
<Base title="Pricing" description={`Websites in Cebu from ${peso(plans[0].price)}, paid once, only after you see a free preview. Care optional from ₱990 a month. Every price published.`} schema={[faqSchema(faqs)]} crumbs={[{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing/' }]}>
  <Hero eyebrow="Prices in pesos" headline="See it free. Pay once if you love it." text="Every price is on this page, and the quote is the published price. No deposit, no contract to start, and care is optional." />

  <Section heading="Websites" intro="One-time prices. You pay in full only after you approve your free preview.">
    <Plans />
  </Section>

  <Section id="preview" heading="How the free preview works" intro="Free, fair and capped, so we can keep offering it.">
    <PreviewRules />
  </Section>

  <Section heading="Care plans" intro="Optional and month to month. Leave anytime and take everything with you.">
    <Care />
  </Section>

  <Section id="low-budget" heading="Little or no budget?" intro="We want every small business in Cebu to own its website. Three ways to start small.">
    <LowBudget />
  </Section>

  <Section heading="Our promise, in writing" intro="It's in every quote we send.">
    <Pledge />
  </Section>

  <Founding />

  <Section heading="After launch, if you want more">
    <ul class="grid gap-5 md:grid-cols-3">
      <li class="tile p-6"><h3 class="text-[1.0625rem]">Extra pages</h3><p class="mt-2 text-[0.9375rem] text-muted">{peso(3000)} each.</p></li>
      <li class="tile p-6"><h3 class="text-[1.0625rem]">AI chat assistant</h3><p class="mt-2 text-[0.9375rem] text-muted">Answers inquiries in English and Cebuano, and hands hard questions to a person. From {peso(1500)} a month.</p></li>
      <li class="tile p-6"><h3 class="text-[1.0625rem]">Social media management</h3><p class="mt-2 text-[0.9375rem] text-muted">From {peso(9990)} a month, for up to 4 clients at a time.</p></li>
    </ul>
  </Section>

  <Section heading="Price questions" layout="split">
    <Faq items={faqs} />
  </Section>

  <CtaBand heading="Get your free preview" label="Get my free preview" text="Not sure which package fits? Tell us what you need and we'll recommend one, with no pressure to buy." />
</Base>
