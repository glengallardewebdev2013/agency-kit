---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import CardGrid from '../../components/CardGrid.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getLocations, getServices } from '../../lib/content';
import { settings } from '../../lib/settings';

export async function getStaticPaths() {
  const locations = await getLocations();
  return locations.map((location) => ({ params: { slug: location.id }, props: { location } }));
}

const { location } = Astro.props;
const { Content } = await render(location);
const d = location.data;
const services = await getServices();
---
<Base
  title={d.seoTitle || `Serving ${d.title}`}
  description={d.seoDescription || d.summary}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Areas', path: '/locations/' }, { name: d.title, path: `/locations/${location.id}/` }]}
>
  <Hero headline={`${settings.name} in ${d.title}`} text={d.summary} primary={{ label: 'Book a visit', href: '/contact/' }} />
  <Section>
    <div class="prose-site"><Content /></div>
  </Section>
  <Section heading={`Services in ${d.title}`} tone="surface">
    <CardGrid cards={services.map((s) => ({ title: s.data.title, text: s.data.summary, href: `/services/${s.id}/` }))} />
  </Section>
  {d.mapQuery && (
    <Section heading="Where we work">
      <MapEmbed query={d.mapQuery} title={`Map of ${d.title}`} />
    </Section>
  )}
  <CtaBand heading={`Need help in ${d.title}?`} />
</Base>
