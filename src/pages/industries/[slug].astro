---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Plans from '../../components/Plans.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getIndustries } from '../../lib/content';
import { faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const industries = await getIndustries();
  return industries.map((industry) => ({ params: { slug: industry.id }, props: { industry } }));
}

const { industry } = Astro.props;
const { Content } = await render(industry);
const d = industry.data;
---
<Base
  title={d.seoTitle || `Websites for ${d.title.toLowerCase()}`}
  description={d.seoDescription || `${d.summary} See your website free first, pay once if you love it.`}
  schema={[faqSchema(d.faqs)]}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Industries', path: '/industries/' }, { name: d.title, path: `/industries/${industry.id}/` }]}
>
  <Hero eyebrow={`For ${d.title.toLowerCase()}`} headline={d.headline} text={d.summary} primary={{ label: 'Get my free preview', href: '/contact/' }} secondary={{ label: 'See the prices', href: '#plans' }} />
  <Section tone="surface">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="prose-site lg:col-span-7"><Content /></div>
      {d.points.length > 0 && (
        <div class="lg:col-span-5">
          <h2 class="text-[2rem]">What your site includes</h2>
          <ul class="mt-6 space-y-3">
            {d.points.map((p) => <li class="flex gap-3"><svg class="mt-[0.35em] h-3.5 w-3.5 flex-none text-accent" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg><span>{p}</span></li>)}
          </ul>
        </div>
      )}
    </div>
  </Section>
  <Section id="plans" heading="One price, paid once" intro="You see a free preview first and pay only if you love it. Care is optional, from ₱990 a month.">
    <Plans />
  </Section>
  {d.faqs.length > 0 && (
    <Section heading="Questions" layout="split">
      <Faq items={d.faqs} />
    </Section>
  )}
  <CtaBand heading="Get your free preview" label="Get my free preview" text="Send a few lines about your business. You'll get a reply within one working day." />
</Base>
