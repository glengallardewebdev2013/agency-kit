---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Plans from '../../components/Plans.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getIndustries } from '../../lib/content';
import { faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const industries = await getIndustries();
  return industries.map((industry) => ({ params: { slug: industry.id }, props: { industry } }));
}

const { industry } = Astro.props;
const { Content } = await render(industry);
const d = industry.data;
---
<Base
  title={d.seoTitle || `Websites for ${d.title.toLowerCase()}`}
  description={d.seoDescription || `${d.summary} Live in 14 days, $0 down, and you own it.`}
  schema={[faqSchema(d.faqs)]}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Industries', path: '/industries/' }, { name: d.title, path: `/industries/${industry.id}/` }]}
>
  <section class="container-site grid gap-10 pt-10 pb-16 md:pt-16 lg:grid-cols-12 lg:pb-24">
    <div class="lg:col-span-8">
      <p class="label">For {d.title.toLowerCase()}</p>
      <h1 class="mt-3 text-5xl md:text-7xl">{d.headline}</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-2 md:text-xl">{d.summary}</p>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a class="btn btn-primary" href="/contact/">Start a project</a>
        <a class="btn btn-secondary" href="#plans">See the plans</a>
      </div>
    </div>
  </section>
  <Section tone="surface">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="prose-site lg:col-span-7"><Content /></div>
      {d.points.length > 0 && (
        <div class="lg:col-span-5">
          <h2 class="text-3xl">What your site includes</h2>
          <ul class="mt-6 space-y-3">
            {d.points.map((p) => <li class="flex gap-3"><span aria-hidden="true" class="font-bold text-mark">+</span><span>{p}</span></li>)}
          </ul>
        </div>
      )}
    </div>
  </Section>
  <Section id="plans" heading="Plans" intro="$0 down, one price a month for 12 months. Live 14 days after we have your content, or month one is free.">
    <Plans />
  </Section>
  {d.faqs.length > 0 && (
    <Section heading="Questions">
      <Faq items={d.faqs} />
    </Section>
  )}
  <CtaBand heading="Let's talk about your site" text="Send a few lines about your business. You'll get a reply within one business day." />
</Base>
