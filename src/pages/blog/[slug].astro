---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { formatDate, getPosts } from '../../lib/content';
import { articleSchema } from '../../lib/schema';
import { settings } from '../../lib/settings';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base
  title={d.seoTitle || d.title}
  description={d.seoDescription || d.summary}
  type="article"
  schema={[articleSchema({ title: d.title, summary: d.summary, slug: post.id, published: d.published, updated: d.updated }, settings)]}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }, { name: d.title, path: `/blog/${post.id}/` }]}
>
  <article class="container-site pt-16 md:pt-24">
    <p class="chip"><span class="chip-dot" aria-hidden="true"></span>Blog</p>
    <h1 class="mt-6 max-w-[20ch] text-[clamp(2.5rem,1.8rem+2.6vw,4rem)]">{d.title}</h1>
    <p class="mt-3 text-muted"><time datetime={d.published.toISOString()}>{formatDate(d.published, settings.locale)}</time></p>
    <div class="prose-site mt-10"><Content /></div>
  </article>
  <CtaBand heading="Need a hand with this?" />
</Base>
