---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CardGrid from '../components/CardGrid.astro';
import Plans from '../components/Plans.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import home from '../content/singletons/home.json';
import { getIndustries } from '../lib/content';
import { faqSchema } from '../lib/schema';
import { foundingSpots } from '../lib/pricing';

const industries = await getIndustries();
const steps = [
  { when: 'Day 0', title: 'A 30-minute call', text: 'We talk about your business, your customers and what the site needs to do. No charge.' },
  { when: 'Day 1', title: 'Your content', text: 'You send text, photos and your logo. If you have none, we help you write and gather them.' },
  { when: 'Days 2 to 10', title: 'Design and build', text: 'A designer lays out your pages, and the build runs in parallel at AI speed.' },
  { when: 'Days 11 to 13', title: 'Your review', text: 'You click through the real site and send changes. We make them.' },
  { when: 'Day 14', title: 'Live', text: 'Your site goes live on your domain, with tracking and search basics in place.' },
];
---
<Base title={home.title} description={home.description} schema={[faqSchema(home.faqs)]}>
  <section class="grid lg:grid-cols-12">
    <div class="container-site !mx-0 !max-w-none pt-12 pb-16 md:pt-16 lg:col-span-7 lg:pb-24 lg:pl-[max(2rem,calc((100vw-var(--container))/2+2rem))]">
      <h1 class="poster max-w-[11ch]">{home.heroHeadline}</h1>
      <p class="mt-8 max-w-xl text-lg text-ink-2 md:text-xl">{home.heroText}</p>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a class="btn btn-primary" href="/contact/">{home.primaryLabel}</a>
        <a class="btn btn-secondary" href="/pricing/">{home.secondaryLabel}</a>
      </div>
    </div>
    <div class="field flex flex-col justify-end gap-6 px-4 py-12 md:px-8 lg:col-span-5 lg:py-24">
      <p class="figure text-[clamp(5rem,13vw,11rem)]">$0</p>
      <p class="text-2xl font-medium md:text-3xl">down. A website you own, live in 14 days.</p>
      <p class="label">Plans from $149 a month for 12 months. 30-day money back.</p>
    </div>
  </section>

  <Section heading={home.reasonsHeading}>
    <CardGrid cards={home.reasons} />
  </Section>

  <Section heading="Live in 14 days" intro="The clock starts the day we have your content. Miss it, and your first month is free." tone="surface">
    <ol class="grid gap-x-8 gap-y-10 md:grid-cols-5">
      {steps.map((s) => (
        <li>
          <p class="label">{s.when}</p>
          <h3 class="mt-2 text-2xl">{s.title}</h3>
          <p class="mt-2 text-ink-2">{s.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section heading="Plans" intro="One price a month for 12 months, $0 down. Or pay once upfront. Hosting, SSL and edits are included.">
    <Plans />
    <p class="mt-8"><a href="/pricing/" class="btn btn-secondary">Full pricing, care and buyout terms</a></p>
  </Section>

  <section class="field--mark py-16 md:py-24">
    <div class="container-site grid gap-10 md:grid-cols-12 md:items-end">
      <p class="figure text-[clamp(8rem,22vw,18rem)] md:col-span-4">{foundingSpots}</p>
      <div class="md:col-span-8">
        <h2 class="text-4xl md:text-6xl">Founding clients keep their price for life</h2>
        <p class="mt-4 max-w-2xl text-lg">The first {foundingSpots} businesses to sign up keep their monthly price for as long as they stay. In return, we ask for a testimonial and a short case study once your site has been live a few months.</p>
        <a href="/contact/" class="btn btn-primary mt-8">Claim a founding spot</a>
      </div>
    </div>
  </section>

  <Section heading="Built for your kind of business" intro="We start with two kinds of business where a well-designed site wins customers fast.">
    <CardGrid cards={industries.map((i) => ({ title: i.data.title, text: i.data.summary, href: `/industries/${i.id}/` }))} />
  </Section>

  <Section heading="You own it. No traps." tone="surface">
    <dl class="grid gap-x-8 gap-y-10 md:grid-cols-3">
      <div><dt class="text-2xl font-bold [font-family:var(--font-display)] tracking-tight">Your content and domain</dt><dd class="mt-3 text-ink-2">Yours from day one. The domain is registered in your name.</dd></div>
      <div><dt class="text-2xl font-bold [font-family:var(--font-display)] tracking-tight">Your site after month 12</dt><dd class="mt-3 text-ink-2">After the first year the site is yours to keep, move or hand to anyone else.</dd></div>
      <div><dt class="text-2xl font-bold [font-family:var(--font-display)] tracking-tight">30-day money back</dt><dd class="mt-3 text-ink-2">Not happy in the first 30 days? You get a full refund.</dd></div>
    </dl>
  </Section>

  <Section heading={home.faqHeading}>
    <Faq items={home.faqs} />
  </Section>

  <CtaBand heading={home.ctaHeading} text={home.ctaText} />
</Base>
