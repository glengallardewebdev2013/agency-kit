---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import IndustryCards from '../components/IndustryCards.astro';
import Plans from '../components/Plans.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Fan from '../components/Fan.astro';
import Steps from '../components/Steps.astro';
import Work from '../components/Work.astro';
import ClientWork from '../components/ClientWork.astro';
import Founding from '../components/Founding.astro';
import Pledge from '../components/Pledge.astro';
import home from '../content/singletons/home.json';
import { faqSchema } from '../lib/schema';
import { foundingSpots } from '../lib/pricing';
---
<Base title={home.title} description={home.description} schema={[faqSchema(home.faqs)]}>
  <section class="hero relative isolate overflow-x-clip">
    <div class="guides" aria-hidden="true"></div>
    <div class="container-site rise flex flex-col items-center pt-16 text-center md:pt-24">
      <p class="chip mb-7"><span class="chip-dot" aria-hidden="true"></span>Cebu City · taking {foundingSpots} founding clients</p>
      <h1 class="max-w-[17ch] text-[length:min(var(--text-h1),10vh+0.5rem)] [font-variation-settings:'opsz'_72]">{home.heroHeadline}</h1>
      <p class="mt-6 max-w-2xl text-[clamp(1.0625rem,0.95rem+0.35vw,1.25rem)] text-muted">{home.heroText}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a class="btn btn-primary" href="/contact/">{home.primaryLabel}</a>
        <a class="btn btn-secondary" href="/pricing/">{home.secondaryLabel}</a>
      </div>
      <p class="mt-4 text-[0.8125rem] text-muted">Human-designed websites, built at AI speed · from ₱18,000 once · no deposit</p>
    </div>
    <Fan />
  </section>

  <Section heading="See it first. Pay only if you love it." intro="No deposit and no contract to start. You click through your real website before you decide.">
    <Steps />
    <p class="mt-10"><a href="/pricing/#preview" class="btn btn-secondary">How the free preview works</a></p>
  </Section>

  <Section heading="Our promise, in writing" intro="Cebu's web market runs on trust. Here's ours, on this page and in every quote.">
    <Pledge />
  </Section>

  <Section heading="Recent work" intro="Websites Glen has built for businesses and a charity in Australia and the US.">
    <ClientWork />
  </Section>

  <Section heading="Design samples" intro="Concepts for the kinds of business we build for, made to show the range. Each one is designed for what it sells, not poured into a template.">
    <Work />
  </Section>

  <Section heading={home.reasonsHeading}>
    <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {home.reasons.map((r) => (
        <li class="border-t border-line pt-5">
          <h3 class="text-[1.0625rem]">{r.title}</h3>
          <p class="mt-2 text-[0.9375rem] text-muted">{r.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section heading="One price, paid once" intro="Every price is on this page, and the quote is the published price. Care is optional, from ₱990 a month.">
    <Plans />
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/pricing/" class="btn btn-secondary">Care plans and full terms</a>
      <a href="/pricing/#low-budget" class="btn btn-secondary">Little or no budget? Start from ₱4,990</a>
    </div>
  </Section>

  <Founding />

  <Section heading="Built for Cebu businesses" intro="We start with businesses where one new customer pays for the whole website.">
    <IndustryCards />
  </Section>

  <Section heading="Free websites for ministries">
    <div class="tile grid gap-6 p-6 md:grid-cols-12 md:items-center md:p-10">
      <p class="text-[1.0625rem] text-ink-2 md:col-span-8">Each year, up to 4 qualified churches, missions and faith-based nonprofits get a complete website from us, free. It's capped so paid work always comes first, and it's how we give back to Cebu.</p>
      <div class="md:col-span-4 md:justify-self-end"><a href="/giving/" class="btn btn-primary">See who qualifies</a></div>
    </div>
  </Section>

  <Section heading={home.faqHeading} layout="split">
    <Faq items={home.faqs} />
  </Section>

  <CtaBand heading={home.ctaHeading} text={home.ctaText} label="Get my free preview" />
</Base>
